import { Button, HorizontalBox, Palette, Switch, VerticalBox } from "std-widgets.slint";

global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> window-bg: dark ? #1e1e1e : #f5f5f7;
    out property <color> sidebar-bg: dark ? #252527 : #ececee;
    out property <color> card-bg: dark ? #2c2c2e : #ffffff;
    out property <color> text: dark ? #f5f5f7 : #1d1d1f;
    out property <color> secondary: dark ? #a1a1a6 : #6e6e73;
    out property <color> border: dark ? #3a3a3c : #e5e5ea;
    out property <color> separator: dark ? #38383a : #ededf0;
    out property <color> selected: dark ? #3a3a3c : #dcdcdf;
    out property <color> hover: dark ? #303032 : #e4e4e7;
    out property <color> error: #ff3b30;
    out property <color> success: #28cd41;
    out property <color> accent: dark ? #0a84ff : #007aff;
    out property <color> field-bg: dark ? #1c1c1e : #f2f2f7;
    out property <color> field-focus-bg: dark ? #2c2c2e : #ffffff;
    out property <color> field-border: dark ? #3a3a3c : transparent;
}

component Separator inherits Rectangle {
    height: 1px;
    background: transparent;
    Rectangle {
        x: 16px;
        width: parent.width - 32px;
        height: 1px;
        background: Theme.separator;
    }
}

component Section inherits VerticalBox {
    in property <string> title;
    spacing: 6px;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    cross-axis-alignment: stretch;

    Text {
        text: root.title;
        font-size: 12px;
        font-weight: 600;
        color: Theme.secondary;
    }

    Rectangle {
        border-radius: 12px;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.border;
        vertical-stretch: 0;
        horizontal-stretch: 1;

        VerticalBox {
            padding-top: 6px;
            padding-bottom: 6px;
            vertical-stretch: 0;
            horizontal-stretch: 1;
            cross-axis-alignment: stretch;
            @children
        }
    }
}

component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> read-only: false;
    in-out property <bool> reveal: false;

    height: 30px;
    border-radius: 7px;
    background: input.has-focus ? Theme.field-focus-bg : Theme.field-bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.field-border;
    clip: true;
    animate background, border-color { duration: 120ms; }

    input := TextInput {
        x: 11px;
        width: root.width - (root.password ? 48px : 22px);
        height: parent.height;
        text <=> root.text;
        single-line: true;
        font-size: 13px;
        color: Theme.text;
        vertical-alignment: center;
        input-type: root.password && !root.reveal ? InputType.password : InputType.text;
        read-only: root.read-only;
    }

    if root.text == "" && !input.has-focus : Text {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        font-size: 13px;
        color: Theme.secondary;
        overflow: clip;
    }

    if root.password : Image {
        x: root.width - 32px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.reveal ? @image-url("../assets/eye-off.png") : @image-url("../assets/eye.png");
        colorize: Theme.secondary;
    }

    if root.password : TouchArea {
        x: root.width - 38px;
        y: 0;
        width: 34px;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.reveal = !root.reveal; }
    }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in property <length> field-width: 210px;
    height: 42px;
    background: transparent;
    horizontal-stretch: 1;

    HorizontalBox {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        cross-axis-alignment: center;

        VerticalBox {
            width: 170px;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.label;
                font-size: 13px;
                color: Theme.text;
            }
            if root.hint != "" : Text {
                text: root.hint;
                font-size: 11px;
                color: Theme.secondary;
                wrap: word-wrap;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        HorizontalBox {
            width: root.field-width;
            cross-axis-alignment: center;
            @children
        }
    }
}

component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <string> hint: "";
    in-out property <bool> checked;
    height: 42px;
    background: transparent;
    horizontal-stretch: 1;

    HorizontalBox {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        cross-axis-alignment: center;

        VerticalBox {
            width: 170px;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.label;
                font-size: 13px;
                color: Theme.text;
            }
            if root.hint != "" : Text {
                text: root.hint;
                font-size: 11px;
                color: Theme.secondary;
                wrap: word-wrap;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        VerticalBox {
            alignment: center;
            Switch {
                checked <=> root.checked;
            }
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked;

    height: 34px;
    border-radius: 7px;
    background: root.selected ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: 130ms; }

    Image {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.selected ? Theme.text : Theme.secondary;
    }

    Text {
        x: 34px;
        y: 0;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        font-size: 13px;
        color: root.selected ? Theme.text : Theme.secondary;
        font-weight: root.selected ? 600 : 400;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    callback clicked;

    width: 64px;
    height: 26px;
    border-radius: 6px;
    background: touch.has-hover
        ? (root.danger ? (Theme.dark ? #3a2224 : #ffebe9) : Theme.hover)
        : transparent;
    animate background { duration: 120ms; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 12px;
        font-weight: 500;
        color: root.danger ? Theme.error : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TrustedAvatar inherits Rectangle {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: Theme.dark ? #17324d : #e8f1ff;

    Text {
        width: parent.width;
        height: parent.height;
        text: "✓";
        font-size: 15px;
        font-weight: 600;
        color: Theme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component StackRow inherits VerticalBox {
    in property <string> label;
    in property <string> hint: "";
    spacing: 6px;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 8px;
    padding-bottom: 8px;

    VerticalBox {
        spacing: 2px;
        Text {
            text: root.label;
            font-size: 13px;
            color: Theme.text;
        }
        if root.hint != "" : Text {
            text: root.hint;
            font-size: 11px;
            color: Theme.secondary;
            wrap: word-wrap;
        }
    }

    @children
}

component TextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;

    height: 64px;
    border-radius: 7px;
    background: input.has-focus ? Theme.field-focus-bg : Theme.field-bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.field-border;
    clip: true;
    animate background, border-color { duration: 120ms; }

    input := TextInput {
        x: 11px;
        y: 7px;
        width: root.width - 22px;
        height: parent.height - 14px;
        text <=> root.text;
        single-line: false;
        wrap: word-wrap;
        font-size: 12px;
        color: Theme.text;
        input-type: InputType.text;
    }

    if root.text == "" && !input.has-focus : Text {
        x: 12px;
        y: 8px;
        width: parent.width - 24px;
        text: root.placeholder;
        font-size: 12px;
        color: Theme.secondary;
        wrap: word-wrap;
    }
}

export struct ConnectionForm {
    device-name: string,
    listen-port: string,
    mdns-enabled: bool,
    peers: string,
}

export struct TrustedDevice {
    device-id: string,
    name: string,
    fingerprint: string,
}

export struct RevokedDevice {
    device-id: string,
    name: string,
    fingerprint: string,
}

export struct LocalForm {
    poll-ms: string,
    max-text-kb: string,
    max-file-mb: string,
    max-batch-mb: string,
    max-files: string,
    file-sync: bool,
    sound-enabled: bool,
}

export component SettingsWindow inherits Window {
    title: "LanPaster 设置";
    background: Theme.window-bg;

    in-out property <int> panel: 0;
    in-out property <string> app-version: "";
    in-out property <string> device-name: "";
    in-out property <string> fingerprint: "";
    in-out property <string> listen-port: "";
    in-out property <bool> mdns-enabled: true;
    in-out property <string> peers: "";
    in-out property <string> poll-ms: "";
    in-out property <string> max-text-kb: "";
    in-out property <string> max-file-mb: "";
    in-out property <string> max-batch-mb: "";
    in-out property <string> max-files: "";
    in-out property <bool> file-sync: true;
    in-out property <bool> sound-enabled: true;
    in-out property <string> status: "";
    in-out property <bool> status-error: false;
    in-out property <bool> status-success: false;
    in-out property <[TrustedDevice]> trusted-devices;
    in-out property <[RevokedDevice]> revoked-devices;
    in-out property <bool> confirming-clear: false;

    callback save-connection(ConnectionForm);
    callback save-local(LocalForm);
    callback forget-device(string);
    callback forget-all-devices();
    callback allow-device(string);
    callback allow-all-devices();
    callback close-window();

    function clear-status() {
        root.status = "";
        root.status-error = false;
        root.status-success = false;
    }

    Timer {
        interval: 4s;
        running: root.confirming-clear;
        triggered => { root.confirming-clear = false; }
    }

    HorizontalBox {
        Rectangle {
            width: 180px;
            background: Theme.sidebar-bg;

            VerticalBox {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 16px;
                padding-bottom: 16px;
                spacing: 4px;

                Text {
                    text: "LanPaster";
                    font-size: 18px;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: "设置";
                    font-size: 11px;
                    color: Theme.secondary;
                }

                Rectangle { height: 18px; }

                Text {
                    text: "偏好设置";
                    font-size: 11px;
                    font-weight: 600;
                    color: Theme.secondary;
                }

                NavItem {
                    label: "连接";
                    icon: @image-url("../assets/nav-connection.png");
                    selected: root.panel == 0;
                    clicked => {
                        root.panel = 0;
                        root.clear-status();
                    }
                }
                NavItem {
                    label: "本地";
                    icon: @image-url("../assets/nav-local.png");
                    selected: root.panel == 1;
                    clicked => {
                        root.panel = 1;
                        root.clear-status();
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Text {
                    text: "v" + root.app-version;
                    font-size: 11px;
                    color: Theme.secondary;
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.window-bg;

            VerticalBox {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 8px;
                cross-axis-alignment: stretch;

                if root.panel == 0 : VerticalBox {
                    width: 100%;
                    spacing: 8px;
                    vertical-stretch: 0;
                    horizontal-stretch: 1;
                    cross-axis-alignment: stretch;

                    Section {
                        title: "设备";
                        horizontal-stretch: 1;
                        SettingRow {
                            label: "设备名称";
                            field-width: 320px;
                            TextField { text <=> root.device-name; placeholder: "例如：MacBook Pro"; }
                        }
                        Separator {}
                        StackRow {
                            label: "设备指纹";
                            hint: "首次连接时核对指纹；对方在菜单栏“连接请求”里同意";
                            TextField { text <=> root.fingerprint; read-only: true; }
                        }
                        Separator {}
                        SettingRow {
                            label: "监听端口";
                            TextField { text <=> root.listen-port; placeholder: "39393"; }
                        }
                    }

                    Section {
                        title: "发现与连接";
                        horizontal-stretch: 1;
                        StackRow {
                            label: "手动节点";
                            hint: "mDNS 不可用时使用，多个节点用逗号或换行分隔";
                            TextArea { text <=> root.peers; placeholder: "192.168.1.20:39393, 192.168.1.21:39393"; }
                        }
                        Separator {}
                        ToggleRow {
                            label: "mDNS 自动发现";
                            hint: "在局域网内自动发现其他设备";
                            checked <=> root.mdns-enabled;
                        }
                    }

                    Section {
                        title: "已信任设备";
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            horizontal-stretch: 1;
                            padding-left: 16px;
                            padding-right: 10px;
                            padding-top: 4px;
                            padding-bottom: 2px;
                            spacing: 8px;
                            cross-axis-alignment: center;

                            if root.confirming-clear : Text {
                                text: "再次点击确认清空";
                                font-size: 11px;
                                color: Theme.error;
                                vertical-alignment: center;
                            }
                            if !root.confirming-clear : HorizontalBox {
                                spacing: 3px;
                                Text {
                                    text: root.trusted-devices.length;
                                    font-size: 11px;
                                    color: Theme.secondary;
                                }
                                Text {
                                    text: "台设备";
                                    font-size: 11px;
                                    color: Theme.secondary;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if root.trusted-devices.length > 0 : TextButton {
                                text: root.confirming-clear ? "确认清空" : "清空全部";
                                danger: true;
                                width: 78px;
                                clicked => {
                                    if root.confirming-clear {
                                        root.confirming-clear = false;
                                        root.forget-all-devices();
                                    } else {
                                        root.confirming-clear = true;
                                    }
                                }
                            }
                        }

                        if root.trusted-devices.length == 0 : VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 560px;
                            alignment: center;
                            cross-axis-alignment: center;
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: 8px;
                            padding-bottom: 14px;
                            spacing: 6px;

                            Rectangle {
                                width: 38px;
                                height: 38px;
                                border-radius: 19px;
                                background: Theme.dark ? #38383a : #f2f2f7;

                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "✓";
                                    font-size: 17px;
                                    font-weight: 600;
                                    color: Theme.secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "暂无已信任设备";
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.text;
                                horizontal-alignment: center;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: "首次连接时，对方在菜单栏“连接请求”里同意后会出现在这里";
                                font-size: 11px;
                                color: Theme.secondary;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        for device in root.trusted-devices : Rectangle {
                            height: 54px;
                            border-radius: 9px;
                            background: Theme.field-bg;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 10px;
                                cross-axis-alignment: center;

                                TrustedAvatar {}

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    alignment: center;

                                    Text {
                                        text: device.name == "" ? "未知设备" : device.name;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "指纹 " + device.fingerprint;
                                        font-size: 11px;
                                        color: Theme.secondary;
                                        overflow: elide;
                                    }
                                }

                                TextButton {
                                    text: "移除";
                                    danger: true;
                                    width: 52px;
                                    clicked => { root.forget-device(device.device-id); }
                                }
                            }
                        }

                        if root.revoked-devices.length > 0 : VerticalBox {
                            padding-left: 16px;
                            padding-right: 10px;
                            padding-top: 8px;
                            padding-bottom: 6px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 6px;
                                cross-axis-alignment: center;

                                Text {
                                    text: "已移除设备（不会自动重新配对）";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.secondary;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }

                                TextButton {
                                    text: "全部恢复";
                                    width: 72px;
                                    clicked => { root.allow-all-devices(); }
                                }
                            }

                            for device in root.revoked-devices : Rectangle {
                                height: 54px;
                                border-radius: 9px;
                                background: Theme.field-bg;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 8px;
                                    spacing: 10px;
                                    cross-axis-alignment: center;

                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: 9px;
                                        background: Theme.dark ? #3a3a3c : #f2f2f7;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "×";
                                            font-size: 16px;
                                            font-weight: 600;
                                            color: Theme.secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        alignment: center;

                                        Text {
                                            text: device.name == "" ? "未知设备" : device.name;
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.text;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: "指纹 " + device.fingerprint;
                                            font-size: 11px;
                                            color: Theme.secondary;
                                            overflow: elide;
                                        }
                                    }

                                    TextButton {
                                        text: "恢复";
                                        width: 52px;
                                        clicked => { root.allow-device(device.device-id); }
                                    }
                                }
                            }
                        }
                    }

                }

                if root.panel == 1 : VerticalBox {
                    width: 100%;
                    spacing: 8px;
                    vertical-stretch: 0;
                    horizontal-stretch: 1;
                    cross-axis-alignment: stretch;

                    Section {
                        title: "剪贴板";
                        horizontal-stretch: 1;
                        SettingRow {
                            label: "轮询间隔 (ms)";
                            hint: "watcher 不可用时的兜底频率";
                            TextField { text <=> root.poll-ms; placeholder: "500"; }
                        }
                        Separator {}
                        SettingRow {
                            label: "文本上限 (KB)";
                            TextField { text <=> root.max-text-kb; placeholder: "1024"; }
                        }
                        Separator {}
                        SettingRow {
                            label: "单文件 / 图片上限 (MB)";
                            hint: "图片按一个文件项计算";
                            TextField { text <=> root.max-file-mb; placeholder: "100"; }
                        }
                        Separator {}
                        SettingRow {
                            label: "单次总量 (MB)";
                            TextField { text <=> root.max-batch-mb; placeholder: "200"; }
                        }
                        Separator {}
                        SettingRow {
                            label: "文件数量上限";
                            TextField { text <=> root.max-files; placeholder: "50"; }
                        }
                    }

                    Section {
                        title: "行为";
                        horizontal-stretch: 1;
                        ToggleRow {
                            label: "同步文件剪贴板";
                            hint: "关闭后只同步文本和图片";
                            checked <=> root.file-sync;
                        }
                        Separator {}
                        ToggleRow {
                            label: "收到剪贴时播放提示音";
                            checked <=> root.sound-enabled;
                        }
                    }

                }

                Rectangle { vertical-stretch: 1; }

                HorizontalBox {
                    spacing: 10px;
                    Text {
                        text: root.status;
                        color: root.status-error ? Theme.error : (root.status-success ? Theme.success : Theme.secondary);
                        font-size: 12px;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: "关闭";
                        clicked => { root.close-window(); }
                    }
                    if root.panel == 0 : Button {
                        text: "保存";
                        primary: true;
                        clicked => {
                            root.save-connection({
                                device-name: root.device-name,
                                listen-port: root.listen-port,
                                mdns-enabled: root.mdns-enabled,
                                peers: root.peers,
                            });
                        }
                    }
                    if root.panel == 1 : Button {
                        text: "保存";
                        primary: true;
                        clicked => {
                            root.save-local({
                                poll-ms: root.poll-ms,
                                max-text-kb: root.max-text-kb,
                                max-file-mb: root.max-file-mb,
                                max-batch-mb: root.max-batch-mb,
                                max-files: root.max-files,
                                file-sync: root.file-sync,
                                sound-enabled: root.sound-enabled,
                            });
                        }
                    }
                }
            }
        }
    }
}
