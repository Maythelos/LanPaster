import { Button, CheckBox, GroupBox, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export struct ConnectionForm {
    device-name: string,
    psk: string,
    listen-port: string,
    mdns-enabled: bool,
    peers: string,
}

export struct LocalForm {
    poll-ms: string,
    max-text-kb: string,
    max-file-mb: string,
    max-batch-mb: string,
    max-files: string,
    file-sync: bool,
    sound-enabled: bool,
}

export component ConnectionWindow inherits Window {
    title: "LanPaster 连接设置";
    preferred-width: 700px;
    preferred-height: 390px;

    in-out property <string> device-name: "";
    in-out property <string> psk: "";
    in-out property <string> listen-port: "";
    in-out property <bool> mdns-enabled: true;
    in-out property <string> peers: "";
    in-out property <string> status: "";

    callback save(ConnectionForm);
    callback close-window();

    VerticalBox {
        spacing: 8px;

        Text {
            text: "连接设置";
            font-size: 20px;
            font-weight: 600;
        }
        Text {
            text: "端口、PSK、mDNS、手动节点修改后需要重启 LanPaster；设备名对新连接和托盘显示生效。";
            color: #666666;
            wrap: word-wrap;
        }

        GroupBox {
            title: "设备与网络";
            VerticalBox {
                spacing: 6px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "设备名称"; width: 160px; }
                    LineEdit { text <=> root.device-name; }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "预共享密钥"; width: 160px; }
                    LineEdit { text <=> root.psk; }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "监听端口"; width: 160px; }
                    LineEdit { text <=> root.listen-port; }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "手动节点"; width: 160px; }
                    LineEdit {
                        text <=> root.peers;
                        placeholder-text: "192.168.1.20:39393, 192.168.1.21:39393";
                    }
                }
                CheckBox {
                    text: "启用 mDNS 自动发现";
                    checked <=> root.mdns-enabled;
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: "保存";
                clicked => {
                    root.save({
                        device-name: root.device-name,
                        psk: root.psk,
                        listen-port: root.listen-port,
                        mdns-enabled: root.mdns-enabled,
                        peers: root.peers,
                    });
                }
            }
            Button {
                text: "关闭";
                clicked => { root.close-window(); }
            }
            Text {
                text: root.status;
                color: #1b7f3a;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }
}

export component LocalWindow inherits Window {
    title: "LanPaster 本地设置";
    preferred-width: 700px;
    preferred-height: 520px;

    in-out property <string> poll-ms: "";
    in-out property <string> max-text-kb: "";
    in-out property <string> max-file-mb: "";
    in-out property <string> max-batch-mb: "";
    in-out property <string> max-files: "";
    in-out property <bool> file-sync: true;
    in-out property <bool> sound-enabled: true;
    in-out property <string> status: "";

    callback save(LocalForm);
    callback close-window();

    VerticalBox {
        spacing: 8px;

        Text {
            text: "本地设置";
            font-size: 20px;
            font-weight: 600;
        }
        Text {
            text: "阈值、文件同步、提示音、轮询间隔保存后自动热加载，不需要重启。图片按一个文件项处理，只校验编码后大小。";
            color: #666666;
            wrap: word-wrap;
        }

        GroupBox {
            title: "剪贴板与文件";
            VerticalBox {
                spacing: 6px;
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "轮询间隔 (ms)"; width: 160px; }
                    LineEdit { text <=> root.poll-ms; }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "文本上限 (KB)"; width: 160px; }
                    LineEdit { text <=> root.max-text-kb; }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "单文件 / 图片上限 (MB)"; width: 160px; }
                    LineEdit { text <=> root.max-file-mb; }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "单次总量 (MB)"; width: 160px; }
                    LineEdit { text <=> root.max-batch-mb; }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: "文件数量上限"; width: 160px; }
                    LineEdit { text <=> root.max-files; }
                }
                CheckBox {
                    text: "同步文件剪贴板";
                    checked <=> root.file-sync;
                }
                CheckBox {
                    text: "收到远端剪贴时播放提示音";
                    checked <=> root.sound-enabled;
                }
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: "保存";
                clicked => {
                    root.save({
                        poll-ms: root.poll-ms,
                        max-text-kb: root.max-text-kb,
                        max-file-mb: root.max-file-mb,
                        max-batch-mb: root.max-batch-mb,
                        max-files: root.max-files,
                        file-sync: root.file-sync,
                        sound-enabled: root.sound-enabled,
                    });
                }
            }
            Button {
                text: "关闭";
                clicked => { root.close-window(); }
            }
            Text {
                text: root.status;
                color: #1b7f3a;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }
}
