import { HorizontalBox, Palette, Switch, VerticalBox } from "std-widgets.slint";

global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;

    // 颜色
    out property <color> window-bg: dark ? #1e1e1e : #f5f5f7;
    out property <color> sidebar-bg: dark ? #252527 : #ececee;
    out property <color> card-bg: dark ? #2c2c2e : #ffffff;
    out property <color> text: dark ? #f5f5f7 : #1d1d1f;
    out property <color> secondary: dark ? #a1a1a6 : #6e6e73;
    out property <color> border: dark ? #3a3a3c : #e5e5ea;
    out property <color> separator: dark ? #38383a : #ededf0;
    out property <color> selected: dark ? #3a3a3c : #dcdcdf;
    out property <color> hover: dark ? #303032 : #e4e4e7;
    out property <color> error: #ff3b30;
    out property <color> error-soft: dark ? #3a2224 : #ffebe9;
    out property <color> success: #28cd41;
    out property <color> accent: dark ? #0a84ff : #007aff;
    out property <color> accent-hover: dark ? #3d9dff : #1a88ff;
    out property <color> accent-pressed: dark ? #006bd6 : #0062cc;
    out property <color> on-accent: #ffffff;
    out property <color> field-bg: dark ? #1c1c1e : #f2f2f7;
    out property <color> field-focus-bg: dark ? #2c2c2e : #ffffff;
    out property <color> field-border: dark ? #3a3a3c : transparent;
    out property <color> button-bg: dark ? #3a3a3c : #ffffff;
    out property <color> button-bg-hover: dark ? #454548 : #f7f7fa;
    out property <color> button-bg-pressed: dark ? #2f2f31 : #ededf2;
    out property <color> button-border: dark ? #4a4a4e : #dcdce1;

    // 尺寸
    out property <length> sidebar-width: 190px;
    out property <length> page-padding: 24px;
    out property <length> card-padding: 16px;
    out property <length> section-gap: 20px;
    out property <length> row-height: 44px;
    out property <length> control-height: 32px;
    out property <length> button-height: 32px;
    out property <length> field-width: 260px;
    out property <length> label-width: 180px;
    out property <length> radius-card: 12px;
    out property <length> radius-control: 8px;
    out property <length> radius-row: 8px;
    out property <length> radius-small: 6px;

    // 字号
    out property <length> font-title: 18px;
    out property <length> font-section: 12px;
    out property <length> font-body: 13px;
    out property <length> font-hint: 11px;
}

component Separator inherits Rectangle {
    height: 1px;
    background: transparent;

    Rectangle {
        x: Theme.card-padding;
        width: parent.width - Theme.card-padding * 2;
        height: 1px;
        background: Theme.separator;
    }
}

component Section inherits VerticalLayout {
    in property <string> title;
    width: 100%;
    spacing: 8px;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    cross-axis-alignment: stretch;

    Text {
        text: root.title;
        font-size: Theme.font-section;
        font-weight: 600;
        color: Theme.secondary;
    }

    Rectangle {
        border-radius: Theme.radius-card;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.border;
        vertical-stretch: 0;
        horizontal-stretch: 1;

        VerticalLayout {
            vertical-stretch: 0;
            horizontal-stretch: 1;
            cross-axis-alignment: stretch;
            @children
        }
    }
}

component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <bool> read-only: false;
    in-out property <bool> reveal: false;

    height: Theme.control-height;
    horizontal-stretch: 1;
    border-radius: Theme.radius-control;
    background: input.has-focus ? Theme.field-focus-bg : Theme.field-bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.field-border;
    clip: true;
    animate background, border-color { duration: 120ms; }

    input := TextInput {
        x: 12px;
        width: root.width - (root.password ? 48px : 24px);
        height: parent.height;
        text <=> root.text;
        single-line: true;
        font-size: Theme.font-body;
        color: Theme.text;
        vertical-alignment: center;
        input-type: root.password && !root.reveal ? InputType.password : InputType.text;
        read-only: root.read-only;
    }

    if root.text == "" && !input.has-focus : Text {
        x: 12px;
        y: 0;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        font-size: Theme.font-body;
        color: Theme.secondary;
        overflow: clip;
    }

    if root.password : Image {
        x: root.width - 32px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.reveal ? @image-url("../assets/eye-off.png") : @image-url("../assets/eye.png");
        colorize: Theme.secondary;
    }

    if root.password : TouchArea {
        x: root.width - 38px;
        y: 0;
        width: 34px;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.reveal = !root.reveal; }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint: "";
    in property <length> field-width: Theme.field-width;

    min-height: Theme.row-height;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    padding-left: Theme.card-padding;
    padding-right: Theme.card-padding;
    padding-top: 6px;
    padding-bottom: 6px;
    spacing: 16px;
    cross-axis-alignment: center;

    VerticalLayout {
        width: Theme.label-width;
        spacing: 2px;
        alignment: center;
        vertical-stretch: 0;

        Text {
            text: root.label;
            font-size: Theme.font-body;
            color: Theme.text;
        }
        if root.hint != "" : Text {
            text: root.hint;
            font-size: Theme.font-hint;
            color: Theme.secondary;
            wrap: word-wrap;
        }
    }

    Rectangle {
        horizontal-stretch: 1;
    }

    HorizontalLayout {
        width: root.field-width;
        spacing: 8px;
        @children
    }
}

component ToggleRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint: "";
    in-out property <bool> checked;

    min-height: Theme.row-height;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    padding-left: Theme.card-padding;
    padding-right: Theme.card-padding;
    padding-top: 6px;
    padding-bottom: 6px;
    spacing: 16px;
    cross-axis-alignment: center;

    VerticalLayout {
        width: Theme.label-width;
        spacing: 2px;
        alignment: center;
        vertical-stretch: 0;

        Text {
            text: root.label;
            font-size: Theme.font-body;
            color: Theme.text;
        }
        if root.hint != "" : Text {
            text: root.hint;
            font-size: Theme.font-hint;
            color: Theme.secondary;
            wrap: word-wrap;
        }
    }

    Rectangle {
        horizontal-stretch: 1;
    }

    VerticalLayout {
        alignment: center;
        vertical-stretch: 0;
        Switch {
            checked <=> root.checked;
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked;

    height: 34px;
    border-radius: Theme.radius-control;
    background: root.selected ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);
    animate background { duration: 130ms; }

    Image {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: root.icon;
        colorize: root.selected ? Theme.text : Theme.secondary;
    }

    Text {
        x: 34px;
        y: 0;
        height: parent.height;
        vertical-alignment: center;
        text: root.label;
        font-size: Theme.font-body;
        color: root.selected ? Theme.text : Theme.secondary;
        font-weight: root.selected ? 600 : 400;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TextButton inherits Rectangle {
    in property <string> text;
    in property <bool> danger: false;
    callback clicked;

    width: 64px;
    height: 28px;
    border-radius: Theme.radius-small;
    background: touch.pressed
        ? (root.danger ? (Theme.dark ? #4a2a2c : #ffd7d3) : Theme.selected)
        : (touch.has-hover
            ? (root.danger ? Theme.error-soft : Theme.hover)
            : transparent);
    animate background { duration: 120ms; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: 12px;
        font-weight: 500;
        color: root.danger ? Theme.error : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked;

    width: 80px;
    height: Theme.button-height;
    border-radius: Theme.radius-control;
    background: root.primary
        ? (touch.pressed ? Theme.accent-pressed : (touch.has-hover ? Theme.accent-hover : Theme.accent))
        : (touch.pressed ? Theme.button-bg-pressed : (touch.has-hover ? Theme.button-bg-hover : Theme.button-bg));
    border-width: root.primary ? 0px : 1px;
    border-color: Theme.button-border;
    animate background { duration: 120ms; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        font-size: Theme.font-body;
        font-weight: 500;
        color: root.primary ? Theme.on-accent : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component TrustedAvatar inherits Rectangle {
    width: 32px;
    height: 32px;
    border-radius: Theme.radius-control;
    background: Theme.dark ? #17324d : #e8f1ff;

    Text {
        width: parent.width;
        height: parent.height;
        text: "✓";
        font-size: 15px;
        font-weight: 600;
        color: Theme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component StackRow inherits VerticalLayout {
    in property <string> label;
    in property <string> hint: "";
    spacing: 8px;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    padding-left: Theme.card-padding;
    padding-right: Theme.card-padding;
    padding-top: 10px;
    padding-bottom: 12px;

    VerticalLayout {
        spacing: 2px;
        vertical-stretch: 0;

        Text {
            text: root.label;
            font-size: Theme.font-body;
            color: Theme.text;
        }
        if root.hint != "" : Text {
            text: root.hint;
            font-size: Theme.font-hint;
            color: Theme.secondary;
            wrap: word-wrap;
        }
    }

    @children
}

component TextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;

    height: 76px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-control;
    background: input.has-focus ? Theme.field-focus-bg : Theme.field-bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.field-border;
    clip: true;
    animate background, border-color { duration: 120ms; }

    input := TextInput {
        x: 12px;
        y: 9px;
        width: root.width - 24px;
        height: parent.height - 18px;
        text <=> root.text;
        single-line: false;
        wrap: word-wrap;
        font-size: Theme.font-body;
        color: Theme.text;
        input-type: InputType.text;
    }

    if root.text == "" && !input.has-focus : Text {
        x: 12px;
        y: 9px;
        width: parent.width - 24px;
        text: root.placeholder;
        font-size: Theme.font-body;
        color: Theme.secondary;
        wrap: word-wrap;
    }
}

export struct ConnectionForm {
    device-name: string,
    listen-port: string,
    mdns-enabled: bool,
    peers: string,
}

export struct TrustedDevice {
    device-id: string,
    name: string,
    fingerprint: string,
}

export struct RevokedDevice {
    device-id: string,
    name: string,
    fingerprint: string,
}

export struct LocalForm {
    poll-ms: string,
    max-text-kb: string,
    max-file-mb: string,
    max-batch-mb: string,
    max-files: string,
    history-minutes: string,
    history-limit: string,
    file-sync: bool,
    sound-enabled: bool,
}

export component SettingsWindow inherits Window {
    title: "LanPaster 设置";
    background: Theme.window-bg;

    in-out property <int> panel: 0;
    in-out property <string> app-version: "";
    in-out property <string> device-name: "";
    in-out property <string> fingerprint: "";
    in-out property <string> listen-port: "";
    in-out property <bool> mdns-enabled: true;
    in-out property <string> peers: "";
    in-out property <string> poll-ms: "";
    in-out property <string> max-text-kb: "";
    in-out property <string> max-file-mb: "";
    in-out property <string> max-batch-mb: "";
    in-out property <string> max-files: "";
    in-out property <string> history-minutes: "";
    in-out property <string> history-limit: "";
    in-out property <bool> file-sync: true;
    in-out property <bool> sound-enabled: true;
    in-out property <string> status: "";
    in-out property <bool> status-error: false;
    in-out property <bool> status-success: false;
    in-out property <[TrustedDevice]> trusted-devices;
    in-out property <[RevokedDevice]> revoked-devices;
    in-out property <bool> confirming-clear: false;

    callback save-connection(ConnectionForm);
    callback save-local(LocalForm);
    callback forget-device(string);
    callback forget-all-devices();
    callback allow-device(string);
    callback allow-all-devices();
    callback close-window();

    function clear-status() {
        root.status = "";
        root.status-error = false;
        root.status-success = false;
    }

    Timer {
        interval: 4s;
        running: root.confirming-clear;
        triggered => { root.confirming-clear = false; }
    }

    HorizontalBox {
        Rectangle {
            width: Theme.sidebar-width;
            background: Theme.sidebar-bg;

            VerticalBox {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 20px;
                padding-bottom: 16px;
                spacing: 6px;

                Text {
                    text: "LanPaster";
                    font-size: Theme.font-title;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: "设置";
                    font-size: Theme.font-hint;
                    color: Theme.secondary;
                }

                Rectangle { height: 14px; }

                Text {
                    text: "偏好设置";
                    font-size: Theme.font-hint;
                    font-weight: 600;
                    color: Theme.secondary;
                }

                VerticalBox {
                    spacing: 4px;
                    NavItem {
                        label: "连接";
                        icon: @image-url("../assets/nav-connection.png");
                        selected: root.panel == 0;
                        clicked => {
                            root.panel = 0;
                            root.clear-status();
                        }
                    }
                    NavItem {
                        label: "本地";
                        icon: @image-url("../assets/nav-local.png");
                        selected: root.panel == 1;
                        clicked => {
                            root.panel = 1;
                            root.clear-status();
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Text {
                    text: "v" + root.app-version;
                    font-size: Theme.font-hint;
                    color: Theme.secondary;
                }
            }
        }

        Rectangle {
            width: 1px;
            background: Theme.border;
        }

        Rectangle {
            horizontal-stretch: 1;
            background: Theme.window-bg;

            VerticalLayout {
                width: 100%;
                padding-left: Theme.page-padding;
                padding-right: Theme.page-padding;
                padding-top: 20px;
                padding-bottom: 16px;
                spacing: 16px;
                cross-axis-alignment: stretch;

                if root.panel == 0 : VerticalLayout {
                    width: 100%;
                    spacing: Theme.section-gap;
                    vertical-stretch: 0;
                    horizontal-stretch: 1;
                    cross-axis-alignment: stretch;

                    Section {
                        title: "设备";
                        horizontal-stretch: 1;
                        SettingRow {
                            label: "设备名称";
                            TextField { text <=> root.device-name; placeholder: "例如：MacBook Pro"; }
                        }
                        Separator {}
                        SettingRow {
                            label: "设备指纹";
                            hint: "首次连接时核对；对方在菜单栏同意";
                            TextField { text <=> root.fingerprint; read-only: true; }
                        }
                        Separator {}
                        SettingRow {
                            label: "监听端口";
                            TextField { text <=> root.listen-port; placeholder: "39393"; }
                        }
                    }

                    Section {
                        title: "发现与连接";
                        horizontal-stretch: 1;
                        StackRow {
                            label: "手动节点";
                            hint: "mDNS 不可用时使用，多个节点用逗号或换行分隔";
                            TextArea { text <=> root.peers; placeholder: "192.168.1.20:39393, 192.168.1.21:39393"; }
                        }
                        Separator {}
                        ToggleRow {
                            label: "mDNS 发现";
                            hint: "在局域网内发现设备；连接需在托盘菜单中手动发起";
                            checked <=> root.mdns-enabled;
                        }
                    }

                    Section {
                        title: "已信任设备";
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            min-height: Theme.row-height;
                            horizontal-stretch: 1;
                            padding-left: Theme.card-padding;
                            padding-right: 8px;
                            padding-top: 4px;
                            padding-bottom: 4px;
                            spacing: 8px;
                            cross-axis-alignment: center;

                            if root.confirming-clear : Text {
                                text: "再次点击确认清空";
                                font-size: Theme.font-hint;
                                color: Theme.error;
                                vertical-alignment: center;
                            }
                            if !root.confirming-clear : HorizontalBox {
                                spacing: 3px;
                                Text {
                                    text: root.trusted-devices.length;
                                    font-size: Theme.font-hint;
                                    color: Theme.secondary;
                                }
                                Text {
                                    text: "台设备";
                                    font-size: Theme.font-hint;
                                    color: Theme.secondary;
                                }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            if root.trusted-devices.length > 0 : TextButton {
                                text: root.confirming-clear ? "确认清空" : "清空全部";
                                danger: true;
                                width: 78px;
                                clicked => {
                                    if root.confirming-clear {
                                        root.confirming-clear = false;
                                        root.forget-all-devices();
                                    } else {
                                        root.confirming-clear = true;
                                    }
                                }
                            }
                        }

                        if root.trusted-devices.length == 0 : VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            cross-axis-alignment: center;
                            padding-left: 24px;
                            padding-right: 24px;
                            padding-top: 12px;
                            padding-bottom: 20px;
                            spacing: 8px;

                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 20px;
                                background: Theme.dark ? #38383a : #f2f2f7;

                                Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "✓";
                                    font-size: 17px;
                                    font-weight: 600;
                                    color: Theme.secondary;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "暂无已信任设备";
                                font-size: Theme.font-body;
                                font-weight: 600;
                                color: Theme.text;
                                horizontal-alignment: center;
                            }

                            Text {
                                horizontal-stretch: 1;
                                text: "首次连接时，对方在菜单栏“连接请求”里同意后会出现在这里";
                                font-size: Theme.font-hint;
                                color: Theme.secondary;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        if root.trusted-devices.length > 0 : VerticalLayout {
                            horizontal-stretch: 1;
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;

                            for device in root.trusted-devices : Rectangle {
                                height: 52px;
                                border-radius: Theme.radius-row;
                                background: Theme.field-bg;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 12px;
                                    cross-axis-alignment: center;

                                    TrustedAvatar {}

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        alignment: center;

                                        Text {
                                            text: device.name == "" ? "未知设备" : device.name;
                                            font-size: Theme.font-body;
                                            font-weight: 600;
                                            color: Theme.text;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: "指纹 " + device.fingerprint;
                                            font-size: Theme.font-hint;
                                            color: Theme.secondary;
                                            overflow: elide;
                                        }
                                    }

                                    TextButton {
                                        text: "移除";
                                        danger: true;
                                        width: 56px;
                                        clicked => { root.forget-device(device.device-id); }
                                    }
                                }
                            }
                        }

                        if root.revoked-devices.length > 0 : VerticalLayout {
                            horizontal-stretch: 1;
                            padding-left: 8px;
                            padding-right: 8px;
                            padding-bottom: 8px;
                            spacing: 6px;

                            Rectangle {
                                height: 1px;
                                background: Theme.separator;
                            }

                            HorizontalLayout {
                                min-height: 36px;
                                padding-left: 8px;
                                padding-right: 4px;
                                spacing: 8px;
                                cross-axis-alignment: center;

                                Text {
                                    text: "已移除设备（不会自动重新配对）";
                                    font-size: Theme.font-hint;
                                    font-weight: 600;
                                    color: Theme.secondary;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }

                                TextButton {
                                    text: "全部恢复";
                                    width: 76px;
                                    clicked => { root.allow-all-devices(); }
                                }
                            }

                            for device in root.revoked-devices : Rectangle {
                                height: 52px;
                                border-radius: Theme.radius-row;
                                background: Theme.field-bg;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 12px;
                                    cross-axis-alignment: center;

                                    Rectangle {
                                        width: 32px;
                                        height: 32px;
                                        border-radius: Theme.radius-control;
                                        background: Theme.dark ? #3a3a3c : #f2f2f7;

                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "×";
                                            font-size: 16px;
                                            font-weight: 600;
                                            color: Theme.secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        alignment: center;

                                        Text {
                                            text: device.name == "" ? "未知设备" : device.name;
                                            font-size: Theme.font-body;
                                            font-weight: 600;
                                            color: Theme.text;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: "指纹 " + device.fingerprint;
                                            font-size: Theme.font-hint;
                                            color: Theme.secondary;
                                            overflow: elide;
                                        }
                                    }

                                    TextButton {
                                        text: "恢复";
                                        width: 56px;
                                        clicked => { root.allow-device(device.device-id); }
                                    }
                                }
                            }
                        }
                    }

                }

                if root.panel == 1 : VerticalLayout {
                    width: 100%;
                    spacing: Theme.section-gap;
                    vertical-stretch: 0;
                    horizontal-stretch: 1;
                    cross-axis-alignment: stretch;

                    Section {
                        title: "剪贴板";
                        horizontal-stretch: 1;
                        SettingRow {
                            label: "轮询间隔 (ms)";
                            hint: "watcher 不可用时的兜底频率";
                            TextField { text <=> root.poll-ms; placeholder: "500"; }
                        }
                        Separator {}
                        SettingRow {
                            label: "文本上限 (KB)";
                            TextField { text <=> root.max-text-kb; placeholder: "1024"; }
                        }
                        Separator {}
                        SettingRow {
                            label: "单文件 / 图片上限 (MB)";
                            hint: "图片按一个文件项计算";
                            TextField { text <=> root.max-file-mb; placeholder: "100"; }
                        }
                        Separator {}
                        SettingRow {
                            label: "单次总量 (MB)";
                            TextField { text <=> root.max-batch-mb; placeholder: "200"; }
                        }
                        Separator {}
                        SettingRow {
                            label: "文件数量上限";
                            TextField { text <=> root.max-files; placeholder: "50"; }
                        }
                    }

                    Section {
                        title: "剪贴历史";
                        horizontal-stretch: 1;
                        SettingRow {
                            label: "保留时长 (分钟)";
                            hint: "仅内存；0 表示关闭";
                            TextField { text <=> root.history-minutes; placeholder: "10"; }
                        }
                        Separator {}
                        SettingRow {
                            label: "最多条目数";
                            hint: "仅内存；0 表示关闭";
                            TextField { text <=> root.history-limit; placeholder: "20"; }
                        }
                    }

                    Section {
                        title: "行为";
                        horizontal-stretch: 1;
                        ToggleRow {
                            label: "同步文件剪贴板";
                            hint: "关闭后只同步文本和图片";
                            checked <=> root.file-sync;
                        }
                        Separator {}
                        ToggleRow {
                            label: "收到剪贴时播放提示音";
                            checked <=> root.sound-enabled;
                        }
                    }

                }

                Rectangle {
                    vertical-stretch: 1;
                    min-height: 0px;
                }

                VerticalLayout {
                    spacing: 10px;
                    vertical-stretch: 0;
                    horizontal-stretch: 1;

                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    HorizontalBox {
                        spacing: 8px;
                        if root.status != "" : Text {
                            text: root.status;
                            color: root.status-error ? Theme.error : (root.status-success ? Theme.success : Theme.secondary);
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        if root.status == "" : Rectangle {
                            horizontal-stretch: 1;
                        }
                        ActionButton {
                            text: "关闭";
                            clicked => { root.close-window(); }
                        }
                        if root.panel == 0 : ActionButton {
                            text: "保存";
                            primary: true;
                            clicked => {
                                root.save-connection({
                                    device-name: root.device-name,
                                    listen-port: root.listen-port,
                                    mdns-enabled: root.mdns-enabled,
                                    peers: root.peers,
                                });
                            }
                        }
                        if root.panel == 1 : ActionButton {
                            text: "保存";
                            primary: true;
                            clicked => {
                                root.save-local({
                                    poll-ms: root.poll-ms,
                                    max-text-kb: root.max-text-kb,
                                    max-file-mb: root.max-file-mb,
                                    max-batch-mb: root.max-batch-mb,
                                    max-files: root.max-files,
                                    history-minutes: root.history-minutes,
                                    history-limit: root.history-limit,
                                    file-sync: root.file-sync,
                                    sound-enabled: root.sound-enabled,
                                });
                            }
                        }
                    }
                }
            }
        }
    }
}
